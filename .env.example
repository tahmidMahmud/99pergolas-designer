# ---------------------------------------------------------------------------------------------
# 99 Pergolas designer — environment variables
#
# Frontend (Vite) variables must start with VITE_ and go in .env.local (never commit it).
# Server (Cloudflare Pages Functions) variables: set in wrangler.toml [vars] (non-secret) or with
#   npx wrangler pages secret put NAME        (secret, production)
# For `npm run preview:cf` locally, put server values in .dev.vars (same KEY=value format).
# ---------------------------------------------------------------------------------------------

# ---- Frontend ---------------------------------------------------------------------------------
# Where the UI posts leads. Empty = same origin (/api/lead) — correct for Pages and for `npm run dev`
# (Vite proxies /api to the dev API on :8787). Set only if the API lives on another origin.
VITE_API_BASE=

# ---- Server: email (Resend, https://resend.com) ------------------------------------------------
# API key (secret). Without it, leads are only logged (and stored in KV) — no email is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender; the domain (99pergolas.com) must be verified in Resend (SPF/DKIM DNS records).
FROM_EMAIL="99 Pergolas <designs@99pergolas.com>"
# Sales inbox(es) that receive each lead, comma-separated.
LEAD_TO=info@99pergolas.com
# Optional BCC on sales notifications, comma-separated.
LEAD_BCC=
# Reply-To on the customer confirmation (default: first LEAD_TO).
REPLY_TO=info@99pergolas.com
# "false" turns off the customer confirmation email.
SEND_CUSTOMER_EMAIL=true

# ---- Server: security / URLs -------------------------------------------------------------------
# Origins allowed to POST /api/lead cross-origin (same-origin is always allowed), comma-separated.
ALLOWED_ORIGINS=https://99pergolas.com,https://www.99pergolas.com
# Public origin used in share links (/d/<code>) and emails. Default: the request's origin.
PUBLIC_BASE_URL=https://design.99pergolas.com
# Max lead submissions per IP per 10 minutes (needs the DESIGNS KV binding). Default 5.
RATE_LIMIT=5

# ---- Server: optional CRM forwarding -----------------------------------------------------------
# Zapier / Make / n8n catch hook; receives the full lead JSON (no base64 image; has snapshotUrl).
ZAPIER_WEBHOOK_URL=
# Sent as X-Webhook-Secret so the hook can reject forged calls.
WEBHOOK_SECRET=
# HubSpot Forms API v3 (unauthenticated). The form needs fields: email, firstname, lastname,
# phone, zip, city, message.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ---- Bindings (wrangler.toml, not env) ---------------------------------------------------------
# DESIGNS  KV namespace — saved designs, snapshots, rate-limit counters. Optional but recommended.

# ---- Local dev API (scripts/dev-api.mjs) -------------------------------------------------------
# PORT=8787
# DEV_PUBLIC_BASE=http://localhost:5173
